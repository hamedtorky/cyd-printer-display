# Keep this file private. Never put a real key in Git or ESP32 firmware.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

MOONRAKER_URL=http://127.0.0.1:7125
MOONRAKER_API_KEY=
CAMERA_SNAPSHOT_URL=http://127.0.0.1:8080/?action=snapshot

# Optional shared secret required as X-Display-Token on analysis endpoints.
GATEWAY_TOKEN=
MIN_ANALYSIS_INTERVAL_SECONDS=60
MAX_IMAGE_BYTES=5000000
MAX_GCODE_BYTES=100000000

# Use "mock" to test without OpenAI credits. "openai" uses the Responses API.
AI_PROVIDER=mock

# Optional OpenAI-compatible Responses endpoint for a future local AI machine.
AI_BASE_URL=
